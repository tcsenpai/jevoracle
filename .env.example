# Required. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional. Port to listen on.
PORT=3737

# Optional. Override the TypeSafe endpoint. Only useful for a proxy or a mock.
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# Optional. Only needed for the "break into factors" feature, which asks a local
# OpenAI-compatible model (Ollama, LM Studio, vLLM) to propose sub-questions.
# Jev still judges every one of them. Leave blank to hide the feature.
DECOMPOSE_URL=http://127.0.0.1:11434/v1
DECOMPOSE_URL_FALLBACK=
DECOMPOSE_MODEL=gemma4:e4b

# --- Paper trading engine ---
# Where the prediction record lives. ENGINE_DB is the old single-bot console,
# JEVKNOWS_DB is the multi-bot platform.
ENGINE_DB=data/engine.db
JEVKNOWS_DB=data/jevknows.db

# --- Decision engines ---
# Three interchangeable engines answer the same typed questions: Jev (remote,
# above), Laya and Kev (both local and unmetered). The default is a weighted
# quorum of all three. The local ones start on demand and shut themselves down
# after an idle period, so nothing holds memory between runs.

# Where the Kev server lives and how long it stays warm.
KEV_HOME=~/coding/_jev/kev
KEV_PORT=8009
KEV_IDLE_MINUTES=10
KEV_BOOT_TIMEOUT_MS=180000

# Laya runs in-process via a Python bridge. Point this at the interpreter that
# actually has `laya` installed: often a venv, not the system python3.
LAYA_PYTHON=
LAYA_IDLE_MINUTES=10

# --- Settlement scheduler ---
# Asks Polymarket whether any open bet has resolved. Free (it only talks to
# Polymarket), so it runs on its own. SCHEDULER=off disables it.
SCHEDULER=on
SCHEDULER_MINUTES=15

# --- Real money. Leave these alone unless you mean it. ---
# Polymarket has NO testnet. pUSD is an ERC-20 on Polygon mainnet backed by real
# USDC, so enabling this spends real money. All three must be set, and the caller
# must also pass confirm:true, before a single order can be signed.
# LIVE_TRADING=i-understand-this-spends-real-money
# POLYMARKET_PRIVATE_KEY=
# MAX_ORDER_USD=5
